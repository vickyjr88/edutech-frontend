# Test Environment Variables
# These are safe defaults for testing - DO NOT put real secrets here

# API Configuration
VITE_API_URL=http://localhost:3001
VITE_API_TIMEOUT=5000

# Feature Flags
VITE_ENABLE_MOCK_API=true
VITE_ENABLE_LOGGING=false

# Third-party Services (use mock values)
VITE_STRIPE_PUBLIC_KEY=pk_test_mock_key
VITE_GOOGLE_MAPS_API_KEY=mock_google_maps_key

# Database (for testing only)
DATABASE_URL=sqlite::memory:

# Auth Configuration
VITE_AUTH_DOMAIN=localhost
VITE_AUTH_CLIENT_ID=test_client_id

# Ory Authentication (Test)
VITE_ORY_SDK_URL=http://localhost:4000
VITE_ORY_PROJECT_ID=test-ory-project-id
