# Development Environment Variables
# Ready-to-use development configuration

# Application Configuration
VITE_APP_TITLE=Kidato E-Learning Platform (Dev)
VITE_APP_VERSION=1.0.0-dev
VITE_APP_DESCRIPTION=Modern e-learning platform for students and educators

# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_API_TIMEOUT=10000

# Authentication Configuration
# Set to 'true' to enable Ory Network authentication (required for OAuth/social login)
# Set to 'false' to use only native email/password authentication
VITE_ENABLE_ORY=false

# Ory Network Configuration (only used when VITE_ENABLE_ORY=true)
# Replace with your actual Ory project ID
VITE_ORY_SDK_URL=http://localhost:4000
VITE_ORY_PROJECT_ID=your-ory-project-id-here

# Third-party Integrations (Development)
VITE_STRIPE_PUBLIC_KEY=pk_test_51example_stripe_key
VITE_GOOGLE_MAPS_API_KEY=dev-google-maps-api-key

# Feature Flags (Development)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_MONITORING=false
VITE_ENABLE_MOCK_API=false

# Development Configuration
VITE_DEBUG_MODE=true
VITE_ENABLE_LOGGING=true
VITE_LOG_LEVEL=debug

# CDN and Assets (Development)
VITE_CDN_URL=http://localhost:3000
VITE_AVATAR_UPLOAD_URL=/api/upload/avatar
VITE_COURSE_MEDIA_URL=/api/upload/course-media

# Notifications (Development)
VITE_ENABLE_PUSH_NOTIFICATIONS=false
VITE_VAPID_PUBLIC_KEY=dev-vapid-public-key

# Monitoring and Analytics (Development - disabled)
VITE_SENTRY_DSN=
VITE_GTM_ID=
VITE_HOTJAR_ID=

# Regional Settings
VITE_DEFAULT_LOCALE=en-US
VITE_DEFAULT_TIMEZONE=UTC
VITE_CURRENCY=USD

# Performance Settings (Development)
VITE_LAZY_LOADING_THRESHOLD=50
VITE_CACHE_TTL=1800000

# Security Settings (Development)
VITE_CSP_REPORT_URI=
VITE_ENABLE_CSP=false
