# E2E Test Environment Variables
# These are safe defaults for E2E testing - DO NOT put real secrets here

# Application URLs
VITE_API_URL=http://localhost:3001
VITE_APP_URL=http://localhost:4173

# Test Configuration
VITE_TEST_TIMEOUT=30000
VITE_ENABLE_MOCK_API=true
VITE_ENABLE_LOGGING=true

# Browser Testing
VITE_HEADLESS_BROWSER=true
VITE_SLOW_MO=0

# Third-party Services (use test/staging values)
VITE_STRIPE_PUBLIC_KEY=pk_test_e2e_key
VITE_GOOGLE_MAPS_API_KEY=mock_google_maps_e2e_key

# Auth Configuration for E2E
VITE_AUTH_DOMAIN=localhost
VITE_AUTH_CLIENT_ID=e2e_client_id

# Ory Authentication (E2E)
VITE_ORY_SDK_URL=http://localhost:4000
VITE_ORY_PROJECT_ID=e2e-ory-project-id

# Test User Credentials (for E2E only)
VITE_TEST_USER_EMAIL=test@example.com
VITE_TEST_USER_PASSWORD=test_password
