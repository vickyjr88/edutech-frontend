# Environment Variables Template for Frontend
# Copy this to .env.local and update with your actual values

# Application Configuration
VITE_APP_TITLE=Kidato E-Learning Platform
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Modern e-learning platform for students and educators

# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_API_TIMEOUT=10000

# Authentication - Ory Network Configuration
# Get these values from your Ory Console project settings
VITE_ORY_SDK_URL=http://localhost:4000
VITE_ORY_PROJECT_ID=your-ory-project-id-here

# Legacy Authentication Configuration (deprecated - for fallback only)
# VITE_KRATOS_PUBLIC_URL=http://127.0.0.1:4433
# VITE_KRATOS_ADMIN_URL=http://127.0.0.1:4434

# Third-party Integrations
VITE_STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_MOCK_API=false

# Development Configuration
VITE_DEBUG_MODE=false
VITE_ENABLE_LOGGING=true
VITE_LOG_LEVEL=info

# Social Authentication (future use)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id
# VITE_GITHUB_CLIENT_ID=your-github-client-id
# VITE_MICROSOFT_CLIENT_ID=your-microsoft-client-id

# CDN and Assets
VITE_CDN_URL=https://cdn.kidato.com
VITE_AVATAR_UPLOAD_URL=/api/upload/avatar
VITE_COURSE_MEDIA_URL=/api/upload/course-media

# Notifications
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Monitoring and Analytics
VITE_SENTRY_DSN=your-sentry-dsn
VITE_GTM_ID=GTM-XXXXXXX
VITE_HOTJAR_ID=your-hotjar-id

# Regional Settings
VITE_DEFAULT_LOCALE=en-US
VITE_DEFAULT_TIMEZONE=UTC
VITE_CURRENCY=USD

# Performance Settings
VITE_LAZY_LOADING_THRESHOLD=100
VITE_CACHE_TTL=3600000

# Security Settings
VITE_CSP_REPORT_URI=https://kidato.report-uri.com/r/d/csp/enforce
VITE_ENABLE_CSP=true
