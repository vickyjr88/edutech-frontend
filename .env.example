# Kidato MVP - Environment Variables Template
# Copy this to .env and update with your actual values

# ===== MVP MODE =====
# Set to 'true' to enable MVP mode (hides non-MVP features from UI)
VITE_MVP_MODE=true

# ===== Application Configuration =====
VITE_APP_TITLE=Kidato - Teacher Marketplace
VITE_APP_VERSION=1.0.0-mvp
VITE_APP_DESCRIPTION=Connecting qualified teachers with students

# ===== API Configuration =====
VITE_API_URL=http://localhost:3000/api/v1
VITE_API_TIMEOUT=10000

# MVP-specific API namespace (for new simplified endpoints)
VITE_MVP_API_URL=http://localhost:3000/api/v1/mvp

# ===== Authentication - Ory Network Configuration =====
# Get these values from your Ory Console project settings
VITE_ORY_SDK_URL=http://localhost:4000
VITE_ORY_PROJECT_ID=your-ory-project-id-here

# LinkedIn OAuth (to be added later)
# VITE_LINKEDIN_CLIENT_ID=your-linkedin-client-id

# ===== Payment Integration =====
# Paystack for M-PESA (MVP Payment Gateway)
VITE_ENABLE_MPESA=true
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key-here
VITE_PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/callback

# Stripe (keep for future, hidden in MVP)
VITE_STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key

# ===== Third-party Integrations =====
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ===== Feature Flags (MVP) =====
# Core Features (Enabled)
VITE_ENABLE_TEACHER_PROFILES=true
VITE_ENABLE_OFFERINGS=true
VITE_ENABLE_BOOKING=true
VITE_ENABLE_MPESA_PAYMENT=true
VITE_ENABLE_ADMIN_PANEL=true
VITE_ENABLE_CMS=true
VITE_ENABLE_BLOG=true
VITE_ENABLE_NEWSLETTER=true

# Advanced Features (Hidden in MVP)
VITE_ENABLE_MESSAGING=false
VITE_ENABLE_ZOOM_INTEGRATION=false
VITE_ENABLE_GOOGLE_CALENDAR=false
VITE_ENABLE_REVIEWS=false
VITE_ENABLE_ADVANCED_ANALYTICS=false
VITE_ENABLE_STUDENT_ACHIEVEMENTS=false
VITE_ENABLE_ASSIGNMENTS=false

# ===== System Flags =====
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_MOCK_API=false

# ===== Development Configuration =====
VITE_DEBUG_MODE=false
VITE_ENABLE_LOGGING=true
VITE_LOG_LEVEL=info

# ===== CDN and Assets =====
VITE_CDN_URL=https://cdn.kidato.com
VITE_AVATAR_UPLOAD_URL=/api/v1/upload/avatar
VITE_COURSE_MEDIA_URL=/api/v1/upload/course-media

# ===== Monitoring and Analytics =====
VITE_SENTRY_DSN=your-sentry-dsn
VITE_GTM_ID=GTM-XXXXXXX
VITE_HOTJAR_ID=your-hotjar-id

# ===== Regional Settings (Kenya) =====
VITE_DEFAULT_LOCALE=en-KE
VITE_DEFAULT_TIMEZONE=Africa/Nairobi
VITE_CURRENCY=KES
VITE_COUNTRY_CODE=KE
VITE_PHONE_PREFIX=254

# ===== Performance Settings =====
VITE_LAZY_LOADING_THRESHOLD=100
VITE_CACHE_TTL=3600000

# ===== Security Settings =====
VITE_CSP_REPORT_URI=https://kidato.report-uri.com/r/d/csp/enforce
VITE_ENABLE_CSP=true
